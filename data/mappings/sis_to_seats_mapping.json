  "date_formats": {
    "description": "Common date formats from different SIS systems",
    "banner": {
      "formats": ["DD-MON-YYYY", "DD-MON-YY", "YYYY-MM-DD", "MM/DD/YYYY"],
      "examples": ["15-JAN-2025", "15-JAN-25", "2025-01-15", "01/15/2025"]
    },
    "peoplesoft": {
      "formats": ["YYYY-MM-DD", "MM/DD/YYYY", "DD/MM/YYYY"],
      "examples": ["2025-01-15", "01/15/2025", "15/01/2025"]
    },
    "workday": {
      "formats": ["YYYY-MM-DD", "ISO8601"],
      "examples": ["2025-01-15", "2025-01-15T00:00:00Z"]
    },
    "generic": {
      "formats": ["YYYY-MM-DD", "MM/DD/YYYY", "DD/MM/YYYY", "M/D/YYYY", "D/M/YYYY", "YYYYMMDD"],
      "examples": ["2025-01-15", "01/15/2025", "15/01/2025", "1/15/2025", "15/1/2025", "20250115"]
    },
    "target_format": "YYYY-MM-DD",
    "notes": "All dates must be converted to YYYY-MM-DD for SEATS"
  },

  "phone_formats": {
    "description": "Phone number format requirements",
    "target_format": "International with country code",
    "pattern": "^(\\+|00)[0-9]{10,15}$",
    "examples": {
      "valid": ["+14155551234", "0014155551234", "+442071234567"],
      "transform_rules": [
        {"from": "(###) ###-####", "to": "+1##########", "country": "US"},
        {"from": "###-###-####", "to": "+1##########", "country": "US"},
        {"from": "0#### ######", "to": "+44##########", "country": "UK"}
      ]
    }
  },

